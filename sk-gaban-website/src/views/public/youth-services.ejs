<%- include("../partials/head", {title}) %><%- include("../partials/nav") %><section class="page-hero"><div class="container"><span class="eyebrow light">GET INVOLVED</span><h1>Youth Services</h1><p>Submit a request or inquiry to the Sangguniang Kabataan.</p></div></section><section class="section-pad"><div class="container narrow"><%- include("../partials/alerts") %><div class="form-panel"><h2>Service request form</h2><p class="muted">Fields marked * are required. Please provide accurate contact details.</p><form method="POST" action="/youth-services"><div class="row g-3"><div class="col-md-8"><label class="form-label">Full name *</label><input name="full_name" class="form-control" required maxlength="160"></div><div class="col-md-4"><label class="form-label">Age *</label><input type="number" name="age" class="form-control" min="15" max="30" required></div><div class="col-md-6"><label class="form-label">Purok / Sitio *</label><input name="purok" class="form-control" required></div><div class="col-md-6"><label class="form-label">Contact number *</label><input name="contact_number" class="form-control" required></div><div class="col-12"><label class="form-label">Email address</label><input type="email" name="email" class="form-control"></div><div class="col-12"><label class="form-label">Type of service *</label><select name="service_type" class="form-select" required><option value="">Select a service</option><option>Scholarship / Educational Assistance Inquiry</option><option>Sports and Youth Activities</option><option>Training and Skills Development</option><option>Volunteer / Youth Participation</option><option>Other Inquiry</option></select></div><div class="col-12"><label class="form-label">Additional details</label><textarea name="message" rows="4" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary btn-lg">Submit request →</button></div></div></form></div></div></section><%- include("../partials/footer") %>
