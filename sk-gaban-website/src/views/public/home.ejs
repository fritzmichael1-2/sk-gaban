<%- include("../partials/head", {title}) %>
<%- include("../partials/nav") %>
<header class="hero">
  <div class="hero-glow"></div>
  <div class="container position-relative">
    <div class="row align-items-center min-vh-hero">
      <div class="col-lg-7 py-5">
        <span class="eyebrow"><span></span> OFFICIAL YOUTH COUNCIL PORTAL</span>
        <h1>Empowering the youth.<br><em>Building our future.</em></h1>
        <p class="hero-lead">Welcome to the official digital platform of Sangguniang Kabataan Barangay Gaban — where young voices, meaningful programs, and community progress come together.</p>
        <div class="d-flex flex-wrap gap-3 mt-4"><a class="btn btn-light btn-lg" href="/projects">Explore our programs <span>→</span></a><a class="btn btn-outline-light btn-lg" href="/about">Meet the SK Council</a></div>
      </div>
      <div class="col-lg-5 d-none d-lg-block">
        <div class="hero-card">
          <div class="hero-card-top"><span class="pulse-dot"></span> YOUTH • SERVICE • PROGRESS</div>
          <div class="hero-emblem">SK<span>GABAN</span></div>
          <div class="hero-card-bottom"><strong>Para sa Kabataan.</strong><small>Para sa Barangay.</small></div>
        </div>
      </div>
    </div>
  </div>
</header>
<section class="quick-strip"><div class="container"><div class="row g-3"><div class="col-md-4"><a href="/announcements" class="quick-link"><span class="quick-icon">✦</span><span><b>Latest Announcements</b><small>Stay informed and updated</small></span><i>→</i></a></div><div class="col-md-4"><a href="/youth-services" class="quick-link"><span class="quick-icon">◎</span><span><b>Youth Services</b><small>Connect with your SK Council</small></span><i>→</i></a></div><div class="col-md-4"><a href="/transparency" class="quick-link"><span class="quick-icon">▤</span><span><b>Transparency Portal</b><small>View reports and public records</small></span><i>→</i></a></div></div></div></section>
<main>
<section class="section-pad"><div class="container"><div class="section-heading"><div><span class="eyebrow blue">WHAT'S HAPPENING</span><h2>Latest announcements</h2><p>Important updates and notices from your Sangguniang Kabataan.</p></div><a class="text-link" href="/announcements">View all announcements →</a></div>
<div class="row g-4"><% if (!announcements.length) { %><div class="col-12"><div class="empty-state">No announcements have been published yet. Please check back soon.</div></div><% } %><% announcements.forEach(item => { %><div class="col-md-4"><article class="content-card"><% if(item.image_url){ %><img src="<%= item.image_url %>" alt="" class="card-image"><% } else { %><div class="card-image card-image-placeholder">SK GABAN</div><% } %><div class="card-body-custom"><span class="category"><%= item.category %></span><h3><%= item.title %></h3><p><%= item.excerpt || item.content.slice(0,130) %></p><a href="/announcements/<%= item.slug %>" class="text-link">Read more →</a></div></article></div><% }) %></div></div></section>
<section class="blue-section"><div class="container"><div class="row align-items-center g-4"><div class="col-lg-7"><span class="eyebrow light">OUR COMMITMENT</span><h2>Creating opportunities.<br>Strengthening communities.</h2><p>We work to promote active youth participation through inclusive programs, responsible leadership, and transparent public service.</p></div><div class="col-lg-5 text-lg-end"><a href="/about" class="btn btn-light btn-lg">Learn about SK Gaban →</a></div></div></div></section>
<section class="section-pad"><div class="container"><div class="section-heading"><div><span class="eyebrow blue">OUR INITIATIVES</span><h2>Programs & projects</h2><p>Discover initiatives designed to support and empower our youth.</p></div><a class="text-link" href="/projects">Explore all projects →</a></div><div class="row g-4"><% if (!projects.length) { %><div class="col-12"><div class="empty-state">Programs and projects will appear here once published.</div></div><% } %><% projects.forEach(item => { %><div class="col-md-4"><article class="simple-card"><span class="category"><%= item.category %></span><h3><%= item.title %></h3><p><%= item.description.slice(0,170) %></p></article></div><% }) %></div></div></section>
<section class="section-pad section-soft"><div class="container"><div class="section-heading"><div><span class="eyebrow blue">SAVE THE DATE</span><h2>Upcoming events</h2><p>Be part of the activities happening in our community.</p></div><a class="text-link" href="/events">View event calendar →</a></div><div class="row g-3"><% if (!events.length) { %><div class="col-12"><div class="empty-state">Upcoming events will be posted here.</div></div><% } %><% events.forEach(item => { %><div class="col-md-4"><div class="event-card"><div class="event-date"><b><%= new Date(item.event_date).getDate() %></b><span><%= new Date(item.event_date).toLocaleString("en-US",{month:"short"}) %></span></div><div><h3><%= item.title %></h3><p><%= item.venue || "Barangay Gaban" %></p></div></div></div><% }) %></div></div></section>
</main>
<%- include("../partials/footer") %>
