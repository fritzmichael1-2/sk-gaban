<%- include("../partials/head", {title}) %><%- include("../partials/nav") %>
<section class="page-hero"><div class="container"><span class="eyebrow light">GET TO KNOW US</span><h1>About SK Gaban</h1><p>Leadership, service, and meaningful youth participation.</p></div></section>
<section class="section-pad"><div class="container narrow"><span class="eyebrow blue">WHO WE ARE</span><h2>A council committed to the youth.</h2><p class="lead-copy">The Sangguniang Kabataan of Barangay Gaban is dedicated to representing the interests of young people and creating opportunities for their development, participation, and well-being.</p><p>This website serves as a central source of information about the council's programs, projects, activities, announcements, and transparency reports.</p><div class="notice-box mt-4"><b>Our guiding principles</b><p class="mb-0">Inclusive participation · Accountable leadership · Youth development · Community service</p></div></div></section>
<section class="section-pad section-soft"><div class="container"><div class="section-heading"><div><span class="eyebrow blue">MEET THE COUNCIL</span><h2>SK officials</h2><p>Meet the people serving the youth of Barangay Gaban.</p></div></div><div class="row g-4"><% if(!officials.length){ %><div class="col-12"><div class="empty-state">Official profiles will be published here by the SK administrator.</div></div><% } %><% officials.forEach(person=>{ %><div class="col-6 col-md-4 col-lg-3"><div class="official-card"><% if(person.image_url){ %><img src="<%= person.image_url %>" alt="<%= person.full_name %>"><% }else{ %><div class="official-placeholder">SK</div><% } %><h3><%= person.full_name %></h3><p><%= person.position %></p><small><%= person.committee || "Sangguniang Kabataan" %></small></div></div><% }) %></div></div></section>
<%- include("../partials/footer") %>
