<%- include("../partials/head", {title}) %><%- include("../partials/nav") %><section class="page-hero"><div class="container"><span class="eyebrow light">COMMUNITY CALENDAR</span><h1>Events & Activities</h1><p>Join our upcoming activities and community celebrations.</p></div></section><section class="section-pad"><div class="container"><div class="row g-3"><% if(!events.length){ %><div class="col-12"><div class="empty-state">No events have been posted yet.</div></div><% } %><% events.forEach(item=>{ %><div class="col-md-6"><div class="event-card large"><div class="event-date"><b><%= new Date(item.event_date).getDate() %></b><span><%= new Date(item.event_date).toLocaleString("en-US",{month:"short"}) %></span></div><div class="flex-grow-1"><span class="category">COMMUNITY EVENT</span><h3><%= item.title %></h3><p><%= item.venue || "Barangay Gaban" %> · <%= new Date(item.event_date).toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric"}) %></p><p><%= item.description %></p></div></div></div><% }) %></div></div></section><%- include("../partials/footer") %>
