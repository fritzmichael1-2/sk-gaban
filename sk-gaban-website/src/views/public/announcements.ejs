<%- include("../partials/head", {title}) %><%- include("../partials/nav") %><section class="page-hero"><div class="container"><span class="eyebrow light">NEWS & UPDATES</span><h1>Announcements</h1><p>Official notices, opportunities, and updates from SK Gaban.</p></div></section><section class="section-pad"><div class="container"><div class="row g-4"><% if(!announcements.length){ %><div class="col-12"><div class="empty-state">There are no published announcements yet.</div></div><% } %><% announcements.forEach(item=>{ %><div class="col-md-6 col-lg-4"><article class="content-card"><% if(item.image_url){ %><img src="<%= item.image_url %>" class="card-image" alt=""><% }else{ %><div class="card-image card-image-placeholder">SK GABAN</div><% } %><div class="card-body-custom"><span class="category"><%= item.category %></span><h3><%= item.title %></h3><p><%= item.excerpt || item.content.slice(0,150) %></p><a class="text-link" href="/announcements/<%= item.slug %>">Read announcement →</a></div></article></div><% }) %></div></div></section><%- include("../partials/footer") %>
