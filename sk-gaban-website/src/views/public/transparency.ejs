<%- include("../partials/head", {title}) %><%- include("../partials/nav") %><section class="page-hero"><div class="container"><span class="eyebrow light">PUBLIC ACCOUNTABILITY</span><h1>Transparency & Reports</h1><p>Access published reports on SK programs, projects, and fund utilization.</p></div></section><section class="section-pad"><div class="container"><div class="notice-box mb-4"><b>Transparency matters.</b><p class="mb-0">This portal is intended to make public information easier to access. Reports are published by authorized SK personnel.</p></div><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Report</th><th>Type</th><th>Year</th><th>Description</th><th>File</th></tr></thead><tbody><% if(!reports.length){ %><tr><td colspan="5" class="text-center py-5 muted">No transparency reports have been published yet.</td></tr><% } %><% reports.forEach(r=>{ %><tr><td><b><%= r.title %></b></td><td><%= r.report_type %></td><td><%= r.report_year %></td><td><%= r.description || "—" %></td><td><% if(r.file_url){ %><a class="text-link" href="<%= r.file_url %>" target="_blank" rel="noopener">View report ↗</a><% }else{ %>—<% } %></td></tr><% }) %></tbody></table></div></div></section><%- include("../partials/footer") %>
