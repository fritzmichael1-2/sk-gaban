<%- include("../partials/head", {title}) %><%- include("../partials/nav") %><section class="page-hero"><div class="container"><span class="eyebrow light">YOUTH DEVELOPMENT</span><h1>Programs & Projects</h1><p>Initiatives that create opportunities and build a stronger community.</p></div></section><section class="section-pad"><div class="container"><div class="row g-4"><% if(!projects.length){ %><div class="col-12"><div class="empty-state">No projects have been published yet.</div></div><% } %><% projects.forEach(item=>{ %><div class="col-md-6 col-lg-4"><article class="content-card"><% if(item.image_url){ %><img src="<%= item.image_url %>" class="card-image" alt=""><% }else{ %><div class="card-image card-image-placeholder">SK INITIATIVE</div><% } %><div class="card-body-custom"><span class="category"><%= item.category %></span><h3><%= item.title %></h3><p><%= item.description %></p><% if(item.start_date){ %><small class="muted">Timeline: <%= new Date(item.start_date).toLocaleDateString() %><%= item.end_date ? " – " + new Date(item.end_date).toLocaleDateString() : "" %></small><% } %></div></article></div><% }) %></div></div></section><%- include("../partials/footer") %>
