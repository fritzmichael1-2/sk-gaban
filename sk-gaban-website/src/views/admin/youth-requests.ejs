<%- include("../partials/admin-head", {title}) %><div class="admin-welcome"><div><span class="eyebrow blue">COMMUNITY</span><h1>Youth service requests</h1><p>Review and update requests submitted through the public portal.</p></div></div><div class="admin-panel"><div class="table-responsive"><table class="table data-table"><thead><tr><th>Applicant</th><th>Contact</th><th>Service</th><th>Details</th><th>Status</th><th>Update</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.full_name %></b><small class="d-block muted"><%= i.age %> years · <%= i.purok %></small></td><td><%= i.contact_number %><small class="d-block muted"><%= i.email || "" %></small></td><td><%= i.service_type %></td><td><%= i.message || "—" %></td><td><span class="status-pill <%= i.status %>"><%= i.status %></span></td><td><form method="POST" action="/admin/youth-requests/<%= i.id %>/status" class="d-flex gap-1"><select name="status" class="form-select form-select-sm"><% ["pending","reviewing","approved","rejected","completed"].forEach(s=>{ %><option value="<%= s %>" <%= i.status===s?"selected":"" %>><%= s %></option><% }) %></select><button class="btn btn-sm btn-primary">Save</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="6" class="text-center py-5 muted">No requests received yet.</td></tr><% } %></tbody></table></div></div><%- include("../partials/admin-foot") %>
