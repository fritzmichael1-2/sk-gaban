<%- include("../partials/admin-head", {title}) %><div class="admin-welcome"><div><span class="eyebrow blue">INBOX</span><h1>Messages</h1><p>Messages sent through the public contact form.</p></div></div><div class="admin-panel"><div class="table-responsive"><table class="table data-table"><thead><tr><th>Sender</th><th>Subject & message</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.full_name %></b><small class="d-block muted"><%= i.email %></small></td><td><b><%= i.subject %></b><p class="mb-0 muted"><%= i.message %></p></td><td><%= new Date(i.created_at).toLocaleDateString() %></td><td><span class="status-pill <%= i.status %>"><%= i.status %></span></td><td><% if(i.status==="unread"){ %><form method="POST" action="/admin/messages/<%= i.id %>/read"><button class="btn btn-sm btn-outline-primary">Mark read</button></form><% } %></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="5" class="text-center py-5 muted">Your inbox is empty.</td></tr><% } %></tbody></table></div></div><%- include("../partials/admin-foot") %>
