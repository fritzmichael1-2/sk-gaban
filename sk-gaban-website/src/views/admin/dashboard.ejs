<%- include("../partials/admin-head", {title}) %><div class="admin-welcome"><div><span class="eyebrow blue">OVERVIEW</span><h1>Good day, <%= currentAdmin.fullName.split(" ")[0] %>.</h1><p>Here's what's happening across your SK Gaban portal.</p></div><a href="/" target="_blank" class="btn btn-outline-primary">View public website ↗</a></div><div class="row g-3 mb-4"><% const cards=[["Announcements",stats.announcements,"✦"],["Projects",stats.projects,"▣"],["Events",stats.events,"◷"],["Transparency reports",stats.reports,"▤"],["Pending youth requests",stats.pendingYouth,"◎"],["Unread messages",stats.unreadMessages,"✉"]]; cards.forEach((c,i)=>{ %><div class="col-6 col-xl-4"><div class="stat-card"><span class="stat-icon"><%= c[2] %></span><div><small><%= c[0] %></small><strong><%= c[1] %></strong></div></div></div><% }) %></div><div class="admin-panel"><div class="panel-heading"><div><h2>Recent youth requests</h2><p>Latest submissions from the public website.</p></div><a href="/admin/youth-requests" class="text-link">View all →</a></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Name</th><th>Service</th><th>Submitted</th><th>Status</th></tr></thead><tbody><% if(!latestRequests.length){ %><tr><td colspan="4" class="text-center py-4 muted">No youth requests yet.</td></tr><% } %><% latestRequests.forEach(r=>{ %><tr><td><b><%= r.full_name %></b><small class="d-block muted"><%= r.contact_number %></small></td><td><%= r.service_type %></td><td><%= new Date(r.created_at).toLocaleDateString() %></td><td><span class="status-pill <%= r.status %>"><%= r.status %></span></td></tr><% }) %></tbody></table></div></div><%- include("../partials/admin-foot") %>
