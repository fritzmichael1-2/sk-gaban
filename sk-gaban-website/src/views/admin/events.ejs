<%- include("../partials/admin-head", {title}) %><div class="admin-welcome"><div><span class="eyebrow blue">CONTENT</span><h1>Events</h1><p>Publish activities, schedules, and community events.</p></div></div><div class="admin-panel mb-4"><h2 class="mb-3">Add event</h2><form method="POST" action="/admin/events" enctype="multipart/form-data"><div class="row g-3"><div class="col-md-8"><label class="form-label">Event title *</label><input name="title" class="form-control" required></div><div class="col-md-4"><label class="form-label">Venue</label><input name="venue" class="form-control"></div><div class="col-md-4"><label class="form-label">Event date *</label><input type="date" name="event_date" class="form-control" required></div><div class="col-md-4"><label class="form-label">Start time</label><input type="time" name="start_time" class="form-control"></div><div class="col-md-4"><label class="form-label">End time</label><input type="time" name="end_time" class="form-control"></div><div class="col-12"><label class="form-label">Description</label><textarea name="description" rows="3" class="form-control"></textarea></div><div class="col-md-6"><label class="form-label">Image</label><input type="file" name="image" accept="image/*" class="form-control"></div><div class="col-md-3"><label class="form-label">Status</label><select name="status" class="form-select"><option value="draft">Draft</option><option value="published">Published</option></select></div><div class="col-12"><button class="btn btn-primary">Save event</button></div></div></form></div><div class="admin-panel"><div class="panel-heading"><h2>All events</h2><span class="muted"><%= items.length %> records</span></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Event</th><th>Date</th><th>Venue</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.title %></b></td><td><%= new Date(i.event_date).toLocaleDateString() %></td><td><%= i.venue %></td><td><span class="status-pill <%= i.status %>"><%= i.status %></span></td><td><form method="POST" action="/admin/events/<%= i.id %>/delete" onsubmit="return confirm('Delete this event?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="5" class="text-center py-4 muted">No records yet.</td></tr><% } %></tbody></table></div></div><%- include("../partials/admin-foot") %>
