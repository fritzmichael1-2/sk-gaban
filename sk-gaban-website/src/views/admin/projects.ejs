<%- include("../partials/admin-head", {title}) %><div class="admin-welcome"><div><span class="eyebrow blue">CONTENT</span><h1>Programs & Projects</h1><p>Manage youth development programs and accomplishments.</p></div></div><div class="admin-panel mb-4"><h2 class="mb-3">Add project</h2><form method="POST" action="/admin/projects" enctype="multipart/form-data"><div class="row g-3"><div class="col-md-8"><label class="form-label">Project title *</label><input name="title" class="form-control" required></div><div class="col-md-4"><label class="form-label">Category</label><input name="category" class="form-control" value="Youth Development"></div><div class="col-12"><label class="form-label">Description *</label><textarea name="description" rows="4" class="form-control" required></textarea></div><div class="col-md-4"><label class="form-label">Start date</label><input type="date" name="start_date" class="form-control"></div><div class="col-md-4"><label class="form-label">End date</label><input type="date" name="end_date" class="form-control"></div><div class="col-md-4"><label class="form-label">Status</label><select name="status" class="form-select"><option value="draft">Draft</option><option value="published">Published</option></select></div><div class="col-md-6"><label class="form-label">Image</label><input type="file" name="image" accept="image/*" class="form-control"></div><div class="col-12"><button class="btn btn-primary">Save project</button></div></div></form></div><div class="admin-panel"><div class="panel-heading"><h2>All projects</h2><span class="muted"><%= items.length %> records</span></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Project</th><th>Category</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.title %></b></td><td><%= i.category %></td><td><span class="status-pill <%= i.status %>"><%= i.status %></span></td><td><form method="POST" action="/admin/projects/<%= i.id %>/delete" onsubmit="return confirm('Delete this project?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="4" class="text-center py-4 muted">No records yet.</td></tr><% } %></tbody></table></div></div><%- include("../partials/admin-foot") %>
