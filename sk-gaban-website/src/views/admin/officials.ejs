<%- include("../partials/admin-head", {title}) %><div class="admin-welcome"><div><span class="eyebrow blue">PEOPLE</span><h1>SK Officials</h1><p>Manage the public directory of your council.</p></div></div><div class="admin-panel mb-4"><h2 class="mb-3">Add official</h2><form method="POST" action="/admin/officials" enctype="multipart/form-data"><div class="row g-3"><div class="col-md-5"><label class="form-label">Full name *</label><input name="full_name" class="form-control" required></div><div class="col-md-4"><label class="form-label">Position *</label><input name="position" class="form-control" placeholder="SK Chairperson / SK Kagawad" required></div><div class="col-md-3"><label class="form-label">Display order</label><input type="number" name="sort_order" class="form-control" value="0"></div><div class="col-md-6"><label class="form-label">Committee</label><input name="committee" class="form-control"></div><div class="col-md-6"><label class="form-label">Profile image</label><input type="file" name="image" accept="image/*" class="form-control"></div><div class="col-12"><button class="btn btn-primary">Add official</button></div></div></form></div><div class="admin-panel"><div class="panel-heading"><h2>Officials directory</h2><span class="muted"><%= items.length %> records</span></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Name</th><th>Position</th><th>Committee</th><th></th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.full_name %></b></td><td><%= i.position %></td><td><%= i.committee || "—" %></td><td><form method="POST" action="/admin/officials/<%= i.id %>/delete" onsubmit="return confirm('Remove this official?')"><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="4" class="text-center py-4 muted">No officials added yet.</td></tr><% } %></tbody></table></div></div><%- include("../partials/admin-foot") %>
